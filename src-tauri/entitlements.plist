<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- rdev / enigo load Core Graphics event-tap libraries that ship outside the
         bundle; Apple's notarization service rejects hardened-runtime apps that
         don't opt in to loading them. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- mDNS discovery, TCP server, relay client and phone-trackpad server all
         need outbound + inbound network access. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
</dict>
</plist>
